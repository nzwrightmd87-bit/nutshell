# Optional local development overrides
CYPHER_CHAT_DB=.tmp/e2ee_chat.db
CYPHER_CHAT_WEB_DIR=web/e2ee_chat

# If blank, the dev server generates an ephemeral signing secret at runtime.
# Set this for stable local sessions across restarts.
# CYPHER_CHAT_TOKEN_SECRET=change_me
CYPHER_CHAT_NUTSHELL_SSO_SECRET=
CYPHER_CHAT_NUTSHELL_SSO_TTL_SECONDS=300
CYPHER_CHAT_NUTSHELL_PUBLIC_URL=http://127.0.0.1:3000

APP_BASE_URL=http://127.0.0.1:8787
PASSWORD_RESET_TTL_SECONDS=3600

# Optional local integrations
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
