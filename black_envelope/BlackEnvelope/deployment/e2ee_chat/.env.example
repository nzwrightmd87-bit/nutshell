# Copy to deployment/e2ee_chat/.env and set new values for the DigitalOcean deployment.

# Public host and TLS
CYPHER_CHAT_HOST=chat.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Auth / bootstrap
CYPHER_CHAT_TOKEN_SECRET=replace_with_long_random_secret
CYPHER_CHAT_NUTSHELL_SSO_SECRET=replace_with_shared_nutshell_sso_secret
CYPHER_CHAT_NUTSHELL_SSO_TTL_SECONDS=300
CYPHER_CHAT_NUTSHELL_PUBLIC_URL=https://nutshell.sbs
# Optional: force a specific username to be admin on startup
# CYPHER_CHAT_ADMIN_USERNAME=your_username
# Optional: initial registration access code if the database has none yet
# CYPHER_CHAT_REGISTRATION_CODE=change_me

# Payload/storage limits
CYPHER_CHAT_DIRECT_PAYLOAD_MAX_BYTES=40000000
CYPHER_CHAT_GROUP_PAYLOAD_MAX_BYTES=150000000
CYPHER_CHAT_STORAGE_LIMIT_BYTES=524288000
CYPHER_CHAT_STORAGE_WARN_BYTES=471859200

# Application base URL
APP_BASE_URL=https://chat.example.com
PASSWORD_RESET_TTL_SECONDS=3600

# Square subscription billing
SQUARE_ENV=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_PLAN_VARIATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://chat.example.com/api/billing/square/webhook
SQUARE_CHECKOUT_REDIRECT_URL=https://chat.example.com/

# Google sign-in
GOOGLE_CLIENT_ID=

# Password reset email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=BlackEnvelope <no-reply@example.com>

# Web push (VAPID)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@example.com
